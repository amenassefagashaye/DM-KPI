    function calcPerformance(plan, ach, direction = 'higher') {
      if (plan === undefined || plan === null || ach === undefined || ach === null) return 0;
      let p = parseFloat(plan), a = parseFloat(ach);
      if (isNaN(p) || isNaN(a) || p === 0) return 0;
      let val;
      if (direction === 'lower') { val = (a <= p) ? 100 : (p / a) * 100; }
      else { val = (a / p) * 100; }
      if (val > 100) val = 100;
      if (val < 0) val = 0;
      return Math.round(val);
    }

    function getStatusClass(perf) {
      if (perf >= 85) return 'status-green';
      if (perf >= 75) return 'status-yellow';
      if (perf >= 50) return 'status-orange';
      return 'status-red';
    }

    function getStatusText(perf) {
      if (perf >= 85) return 'Excellent';
      if (perf >= 75) return 'Satisfactory';
      if (perf >= 50) return 'Weak';
      return 'Critical';
    }

    function getStatusTextAm(perf) {
      if (perf >= 85) return 'በጣም ጥሩ';
      if (perf >= 75) return 'ጥሩ';
      if (perf >= 50) return 'ደካማ';
      return 'አሳሳቢ';
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/[&<>"]/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m];
      });
    }

    function updateAllIndicators() {
      hcIndicators.forEach(k => {
        k.performance = calcPerformance(k.plan, k.achievement, k.direction || 'higher');
      });
      hcAgendas.forEach(ag => {
        let items = hcIndicators.filter(i => i.agenda === ag.id);
        if (items.length) {
          let totalWeight = items.reduce((s, i) => s + (i.weight || 0), 0);
          let weightedSum = items.reduce((s, i) => s + ((i.performance || 0) * (i.weight || 0)), 0);
          ag.score = totalWeight > 0 ? Math.round(weightedSum / totalWeight) : 0;
        } else {
          ag.score = 0;
        }
      });
      healthPosts.forEach(hp => {
        let indicators = hpIndicators[hp.id] || [];
        hp.irScore = calcAgendaScore(indicators.filter(i => i.agenda === 'ir'));
        hp.lgScore = calcAgendaScore(indicators.filter(i => i.agenda === 'lg'));
        hp.qeScore = calcAgendaScore(indicators.filter(i => i.agenda === 'qe'));
        hp.overall = Math.round(hp.irScore * 0.20 + hp.lgScore * 0.30 + hp.qeScore * 0.50);
      });
    }

    function calcAgendaScore(items) {
      if (!items || items.length === 0) return 0;
      let totalWeight = items.reduce((s, i) => s + (i.weight || 0), 0);
      if (totalWeight === 0) return 0;
      let weightedSum = items.reduce((s, i) => {
        return s + (calcPerformance(i.plan, i.achievement, i.direction || 'higher') * (i.weight || 0));
      }, 0);
      return Math.round(weightedSum / totalWeight);
    }

    function getHCScore() {
      let totalWeight = hcAgendas.reduce((s, a) => s + a.weight, 0);
      if (totalWeight === 0) return 0;
      let weightedSum = hcAgendas.reduce((s, a) => s + (a.score * a.weight), 0);
      return Math.round(weightedSum / totalWeight);
    }

    function getPHCUScore() {
      let hcScore = getHCScore();
      let hpAvg = healthPosts.length > 0
        ? Math.round(healthPosts.reduce((s, hp) => s + hp.overall, 0) / healthPosts.length)
        : 0;
      return Math.round(hcScore * 0.6 + hpAvg * 0.4);
    }

