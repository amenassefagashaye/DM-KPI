              <button onclick="window._copyAndClose('${encodedText.replace(/'/g, "\\'")}')" style="text-decoration:none;display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 6px;border-radius:12px;background:#f1f5f9;border:none;cursor:pointer;transition:all 0.2s;">
                <i class="fas fa-copy" style="font-size:1.6rem;color:#475569;"></i>
                <span style="font-size:0.7rem;font-weight:600;color:#475569;">Copy</span>
              </button>
            </div>
            <button onclick="document.getElementById('shareOverlay').remove()" style="width:100%;padding:12px;border-radius:12px;border:2px solid #e2e8f0;background:white;font-weight:700;font-size:0.85rem;color:#475569;cursor:pointer;font-family:'Times New Roman','Noto Sans Ethiopic',serif;">Cancel</button>
          </div>
        </div>
      `;
      const div = document.createElement('div');
      div.innerHTML = shareHtml;
      document.body.appendChild(div.firstElementChild);

      window._copyAndClose = function(encText) {
        copyToClipboard(decodeURIComponent(encText), 'Copied to clipboard!');
        const overlay = document.getElementById('shareOverlay');
        if (overlay) overlay.remove();
      };
    }

    function handleLogin() {
      const username = document.getElementById('usernameSelect').value;
      const password = document.getElementById('passwordInput').value.trim();
      const usernameError = document.getElementById('usernameError');
      const passwordError = document.getElementById('passwordError');

      usernameError.classList.remove('show');
      passwordError.classList.remove('show');
      document.getElementById('usernameSelect').classList.remove('error');
      document.getElementById('passwordInput').classList.remove('error');

      let valid = true;

      if (!username) {
        usernameError.classList.add('show');
        document.getElementById('usernameSelect').classList.add('error');
        valid = false;
      }

      if (!password) {
        passwordError.classList.add('show');
        document.getElementById('passwordInput').classList.add('error');
        valid = false;
      }

      if (!valid) return;

      if (username === 'Health Center') {
        currentUser = { name: 'Health Center', role: 'hc' };
      } else if (username === 'Health Post / የጤና ኬላ') {
        currentUser = { name: 'Health Post', role: 'hp' };
      } else if (username === 'Admin') {
        currentUser = { name: 'Admin', role: 'admin' };
      } else {
        return;
      }

      document.getElementById('page-login').classList.remove('active');

      if (currentUser.role === 'hc') {
        openHC();
      } else if (currentUser.role === 'hp') {
        openHPs();
      } else if (currentUser.role === 'admin') {
        openAdmin();
      }

      updateHomeCounts();
    }

    function toggleFullscreen() {
      const doc = document.documentElement;
      const btn = document.getElementById('fullscreenBtn');
      if (!document.fullscreenElement) {
        if (doc.requestFullscreen) doc.requestFullscreen();
        else if (doc.webkitRequestFullscreen) doc.webkitRequestFullscreen();
        if (btn) btn.innerHTML = '<i class="fas fa-compress"></i>';
      } else {
        if (document.exitFullscreen) document.exitFullscreen();
        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
        if (btn) btn.innerHTML = '<i class="fas fa-expand"></i>';
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('fullscreenBtn').addEventListener('click', toggleFullscreen);

      document.getElementById('loginBtn').addEventListener('click', handleLogin);

      document.getElementById('passwordInput').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          handleLogin();
        }
      });

      document.getElementById('usernameSelect').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          document.getElementById('passwordInput').focus();
        }
      });

      document.getElementById('hcCard').addEventListener('click', openHC);
      document.getElementById('hcCard').addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openHC(); }
      });
      document.getElementById('hpCard').addEventListener('click', openHPs);
      document.getElementById('hpCard').addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openHPs(); }
      });
      document.getElementById('adminCard').addEventListener('click', openAdmin);
      document.getElementById('adminCard').addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openAdmin(); }
      });

      updateAllIndicators();
      updateHomeCounts();
      console.log('Debremarkose PHCU KPI initialized.');
    });

  })();
</script>

</body>
</html>
